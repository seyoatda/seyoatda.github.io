---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;
---

<div class="post-list">
  {posts.map((post) => {
    const { title, date, draft, tags, pinned } = post.data;
    const dateStr = date.toLocaleDateString('zh-CN', {
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    });
    const firstTag = tags.length > 0 ? tags[0] : null;
    return (
      <a
        href={`/posts/${post.id.replace(/\.md$/, '')}/`}
        class={`post-item${pinned ? ' is-pinned' : ''}`}
      >
        <span class="post-title">
          {draft && <span class="draft-badge">草稿</span>}
          {title}
        </span>
        <span class="post-meta-right">
          {firstTag && <span class="post-first-tag">#{firstTag}</span>}
          <time class="post-date">{dateStr}</time>
        </span>
      </a>
    );
  })}
</div>

<style>
.post-list {
  display: flex;
  flex-direction: column;
}
.post-item {
  display: flex;
  align-items: baseline;
  justify-content: flex-start;
  gap: 1rem;
  padding: 0.6rem 0.5rem;
  border-bottom: 1px dashed var(--color-border);
  transition: background 0.15s;
}
.post-item:last-child {
  border-bottom: none;
}
.post-item:hover {
  background: var(--color-bg-soft);
}
.post-title {
  flex: 1;
  font-size: 1rem;
  font-weight: 500;
  color: var(--color-text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  display: flex;
  align-items: center;
  gap: 0.4rem;
  text-align: left;
}
.post-item:hover .post-title {
  color: var(--color-primary);
}
.draft-badge {
  font-size: 0.65rem;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  padding: 0.1em 0.4em;
  border-radius: 3px;
  font-weight: 400;
  flex-shrink: 0;
}
.post-meta-right {
  display: flex;
  align-items: baseline;
  gap: 0.8rem;
  flex-shrink: 0;
  white-space: nowrap;
}
.post-first-tag {
  font-size: 0.78rem;
  color: var(--color-text-muted);
}
.post-item:hover .post-first-tag {
  color: var(--color-primary);
}
.post-date {
  font-size: 0.8rem;
  color: var(--color-text-muted);
  font-family: var(--font-mono);
}

/* 置顶文章：加深的背景色 + 加粗标题 */
.post-item.is-pinned {
  background: var(--color-bg-hover);
  border-left: 3px solid var(--color-primary);
  padding-left: calc(0.5rem - 3px);
}
.post-item.is-pinned:hover {
  background: var(--color-bg-hover);
}
.post-item.is-pinned .post-title {
  font-weight: 600;
}

/* 移动端 */
@media (max-width: 640px) {
  .post-item {
    padding: 0.5rem 0.25rem;
    gap: 0.5rem;
  }
  .post-title {
    font-size: 0.92rem;
  }
  .post-meta-right {
    gap: 0.5rem;
  }
  .post-first-tag {
    font-size: 0.72rem;
  }
  .post-date {
    font-size: 0.75rem;
  }
}
</style>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';

// 预生成所有文章页面的路径
export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    // 去掉文件扩展名，生成简洁 URL
    params: { id: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const { title, date, tags, draft, category, updated } = post.data;

// 过滤出 h2/h3 作为目录
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);

const dateStr = date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const updatedStr = updated
  ? updated.toLocaleDateString('zh-CN', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;

// 分类中文名
const categoryName: Record<string, string> = {
  tech: '技术',
  poetry: '诗',
  life: '遐思',
};
const catName = categoryName[category] || category;
---

<BaseLayout title={`${title} - ${SITE.title}`}>
  <div class="post-layout">
    <article class="prose">
      <header class="post-header">
        <div class="post-breadcrumb">
          <a href="/">首页</a>
          <span class="breadcrumb-sep">/</span>
          <a href={`/${category}/`}>{catName}</a>
        </div>
        <h1 class="post-title">
          {draft && <span class="draft-badge">草稿</span>}
          {title}
        </h1>
        <div class="post-meta">
          <time class="post-date">{dateStr}</time>
          {updatedStr && <span class="post-updated">（更新于 {updatedStr}）</span>}
          {tags.length > 0 && (
            <span class="post-tags-inline">
              {tags.map((tag) => (
                <a href={`/tags/${tag}/`} class="post-tag">#{tag}</a>
              ))}
            </span>
          )}
        </div>
      </header>

      <Content />

      <footer class="post-footer">
        <hr />
        <div class="post-footer-nav">
          <a href={`/${category}/`} class="back-link">← 返回{catName}</a>
        </div>
      </footer>
    </article>

    {tocHeadings.length > 0 && (
      <aside class="toc" id="toc">
        <nav class="toc-nav">
          <p class="toc-title">目录</p>
          <ul>
            {tocHeadings.map((h) => (
              <li class={`toc-item toc-depth-${h.depth}`}>
                <a href={`#${h.slug}`} class="toc-link" data-target={h.slug}>{h.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
    )}
  </div>
</BaseLayout>

<style>
.post-layout {
  position: relative;
  max-width: var(--content-width);
  margin: 0 auto;
  padding: 0 1rem;
}
.prose {
  margin: 0;
  padding: 2rem 0;
}
.toc {
  position: fixed;
  top: 4rem;
  /* 正文居中后，右侧空间 = 视口右半 - 正文右半 - 间隔 */
  left: calc(50% + var(--content-width) / 2 + 2.5rem);
  width: 200px;
  max-height: calc(100vh - 5rem);
  overflow-y: auto;
  font-size: 0.88rem;
}
.toc-nav {
  border-left: 2px solid var(--color-border);
  padding-left: 1rem;
}
.toc-title {
  font-weight: 600;
  color: var(--color-text-muted);
  margin-bottom: 0.6rem;
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}
.toc ul {
  list-style: none;
}
.toc-item {
  margin-bottom: 0.4rem;
}
.toc-depth-3 {
  padding-left: 1rem;
}
.toc-link {
  color: var(--color-text-muted);
  display: block;
  padding: 0.2rem 0;
  transition: color 0.2s;
  line-height: 1.5;
}
.toc-link:hover {
  color: var(--color-primary);
  opacity: 1;
}
.toc-link.active {
  color: var(--color-primary);
  font-weight: 500;
}

/* 窄屏：隐藏浮动目录 */
@media (max-width: 1280px) {
  .toc {
    display: none;
  }
}

/* 文章头部 */
.post-header {
  margin-bottom: 2rem;
}
.post-breadcrumb {
  font-size: 0.82rem;
  color: var(--color-text-muted);
  margin-bottom: 0.5rem;
}
.breadcrumb-sep {
  margin: 0 0.3rem;
}
.post-title {
  font-size: 1.7rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 0.5rem;
}
.draft-badge {
  font-size: 0.7rem;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  padding: 0.15em 0.6em;
  border-radius: 4px;
  font-weight: 500;
}
.post-meta {
  font-size: 0.82rem;
  color: var(--color-text-muted);
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-wrap: wrap;
}
.post-tags-inline {
  display: flex;
  gap: 0.5rem;
}
.post-tag {
  color: var(--color-text-muted);
}
.post-tag:hover {
  color: var(--color-primary);
}
.post-footer {
  margin-top: 3rem;
}
.post-footer-nav {
  margin-top: 1.5rem;
}
.back-link {
  font-size: 0.9rem;
  color: var(--color-text-muted);
}
</style>

<script>
  // 滚动时高亮当前目录项
  const tocLinks = document.querySelectorAll('.toc-link');
  if (tocLinks.length > 0) {
    const headings = Array.from(tocLinks).map(link => {
      const id = link.getAttribute('data-target');
      return { id, el: document.getElementById(id), link };
    }).filter(h => h.el);

    function updateActive() {
      const scrollY = window.scrollY;
      let activeIdx = 0;
      for (let i = 0; i < headings.length; i++) {
        if (headings[i].el.offsetTop - 100 <= scrollY) {
          activeIdx = i;
        }
      }
      headings.forEach((h, i) => {
        h.link.classList.toggle('active', i === activeIdx);
      });
    }

    window.addEventListener('scroll', updateActive, { passive: true });
    updateActive();
  }
</script>

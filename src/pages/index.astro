---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { SITE } from '../consts';

// 首页不显示诗眠标签文章，置顶在前（按 pinnedOrder 升序），其余按日期降序
const posts = (await getCollection('posts', ({ data }) => !data.draft && !data.tags.includes('诗眠')))
  .sort((a, b) => {
    const ap = a.data.pinned ? 0 : 1;
    const bp = b.data.pinned ? 0 : 1;
    if (ap !== bp) return ap - bp;
    if (a.data.pinned && b.data.pinned) return a.data.pinnedOrder - b.data.pinnedOrder;
    return b.data.date.getTime() - a.data.date.getTime();
  });

const { title, motto } = SITE;
---

<BaseLayout title={title}>
  <section class="home">
    <div class="home-hero">
      <h1 class="home-title">{title}</h1>
      <p class="home-motto">{motto}</p>
    </div>
    <PostList posts={posts} />
  </section>
</BaseLayout>

<style>
.home {
  max-width: var(--layout-width);
  margin: 0 auto;
  padding: 2.5rem 1rem 3rem;
}
.home-hero {
  margin-bottom: 2rem;
  padding-bottom: 1.5rem;
  border-bottom: 1px solid var(--color-border);
}
.home-title {
  font-size: 1.8rem;
  font-weight: 700;
  margin-bottom: 0.3rem;
}
.home-motto {
  color: var(--color-text-muted);
  font-size: 0.95rem;
  font-style: italic;
}
</style>

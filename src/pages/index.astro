---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { SITE } from '../consts';

// 获取所有已发布的文章，按日期降序排列
const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const { title, motto } = SITE;
---

<BaseLayout title={title}>
  <section class="hero">
    <h1 class="hero-title">{title}</h1>
    <p class="hero-motto">{motto}</p>
  </section>

  <section class="home-posts">
    <div class="home-posts-header">
      <h2>最新文章</h2>
    </div>
    <PostList posts={posts} />
    {posts.length === 0 && <p class="empty">还没有文章，敬请期待。</p>}
  </section>
</BaseLayout>

<style>
.hero {
  text-align: center;
  padding: 4rem 1rem 3rem;
  background: linear-gradient(90deg,
    rgba(247, 149, 51, 0.06) 0%,
    rgba(243, 112, 85, 0.06) 15%,
    rgba(239, 78, 123, 0.06) 30%,
    rgba(161, 102, 171, 0.06) 44%,
    rgba(80, 115, 184, 0.06) 58%,
    rgba(16, 152, 173, 0.06) 72%,
    rgba(7, 179, 155, 0.06) 86%,
    rgba(109, 186, 130, 0.06) 100%
  );
}
.hero-title {
  font-size: 2.5rem;
  font-weight: 700;
  margin-bottom: 0.5rem;
}
.hero-motto {
  color: var(--color-text-muted);
  font-size: 1.05rem;
  font-style: italic;
}
.home-posts {
  max-width: var(--layout-width);
  margin: 0 auto;
  padding: 0 1rem 2rem;
}
.home-posts-header {
  margin-bottom: 1rem;
}
.home-posts-header h2 {
  font-size: 1.3rem;
  font-weight: 600;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid var(--color-border);
}
.empty {
  text-align: center;
  color: var(--color-text-muted);
  padding: 2rem;
}
</style>
